<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The forecast and place search (Open-Meteo); see docs/weather.md. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: the forecast for where you are. Asked only when turned on. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Optional morning forecast, rain and warning notifications (asked when one is turned on). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tessera">
        <!-- Left out of Tessera backups: cached forecasts. -->
        <meta-data
            android:name="io.github.michaelmassoni.tessera.BACKUP_EXCLUDE"
            android:value="files/forecasts/" />
        <!-- Launched through the activity-alias entries below and the custom icon shortcut. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!--
            Launcher entries, one per built-in icon style. Exactly one is enabled at a time;
            core:settings (AppIcons) switches them when the user picks an icon in Settings.
        -->
        <activity-alias
            android:name=".LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Exported for system Settings > Apps > (app) > settings link. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Weather widgets (Glance): forecast, and date & weather. The background check keeps them
             fresh while one is placed; they also redraw on time, time zone and locale changes. -->
        <receiver
            android:name=".widget.WeatherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.DateWeatherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_date_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_date_info" />
        </receiver>
        <!-- The date widget's redraw at midnight. -->
        <receiver
            android:name=".widget.WeatherWidgetTick"
            android:exported="false" />
        <!-- A widget's settings: opened by the launcher when one is placed or reconfigured. -->
        <activity
            android:name=".widget.WeatherWidgetSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
