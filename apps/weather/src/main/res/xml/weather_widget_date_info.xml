<?xml version="1.0" encoding="utf-8"?>
<!-- Redraws at midnight (WeatherWidgetTick) and with the background check. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_date_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="50dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:configure="io.github.michaelmassoni.tessera.weather.widget.WeatherWidgetSettingsActivity"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen" />
