<?xml version="1.0" encoding="utf-8"?>
<!-- The live score notification's text, built on the system's notification styles (light and dark). -->
<resources>
    <style name="LiveScore" parent="@android:style/TextAppearance.Material.Notification.Title">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="LiveScore.Small">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="LiveStatus" parent="@android:style/TextAppearance.Material.Notification.Title">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="LiveName" parent="@android:style/TextAppearance.Material.Notification">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="LiveSecondary" parent="@android:style/TextAppearance.Material.Notification.Info">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="LivePlay" parent="@android:style/TextAppearance.Material.Notification">
        <item name="android:textSize">14sp</item>
    </style>
</resources>
