<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: "New recording". -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_record"
        android:shortcutId="record"
        android:shortcutShortLabel="@string/shortcut_record">
        <intent
            android:action="io.github.michaelmassoni.tessera.recorder.RECORD"
            android:targetClass="io.github.michaelmassoni.tessera.recorder.MainActivity"
            android:targetPackage="io.github.michaelmassoni.tessera.recorder" />
    </shortcut>
</shortcuts>
