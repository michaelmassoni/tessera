<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:icon="@drawable/ic_shortcut_timer"
        android:shortcutId="timer"
        android:shortcutShortLabel="@string/shortcut_timer">
        <intent
            android:action="android.intent.action.SHOW_TIMERS"
            android:targetClass="io.github.michaelmassoni.tessera.clock.MainActivity"
            android:targetPackage="io.github.michaelmassoni.tessera.clock" />
    </shortcut>
    <shortcut
        android:icon="@drawable/ic_shortcut_stopwatch"
        android:shortcutId="stopwatch"
        android:shortcutShortLabel="@string/shortcut_stopwatch">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="io.github.michaelmassoni.tessera.clock.MainActivity"
            android:targetPackage="io.github.michaelmassoni.tessera.clock">
            <extra
                android:name="tab"
                android:value="3" />
        </intent>
    </shortcut>
</shortcuts>
