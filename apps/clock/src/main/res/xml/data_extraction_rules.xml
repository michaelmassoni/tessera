<?xml version="1.0" encoding="utf-8"?>
<!-- Alarms, cities and settings move with the user. Live state (running timers, stopwatch,
     what is ringing) is tied to this device's clocks and is never restored. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="device_file" path="alarms.json" />
        <include domain="device_file" path="cities.json" />
        <include domain="device_file" path="settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="device_file" path="alarms.json" />
        <include domain="device_file" path="cities.json" />
        <include domain="device_file" path="settings.json" />
    </device-transfer>
</data-extraction-rules>
